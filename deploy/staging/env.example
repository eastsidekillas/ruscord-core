# The test server's .env (docs/deploy-staging.md). Generate with
#   scripts/gen-env.sh deploy/staging/env.example > .env
# then fill in RUSCORD_DOMAIN and RUSCORD_ACME_EMAIL. Never commit .env.
RUSCORD_ENV=staging
RUSCORD_ROLES=all

# The site's domain, its DNS A record pointing at this server; Caddy gets
# its certificate from Let's Encrypt.
RUSCORD_DOMAIN=

# local: LiveKit's public address is found via STUN. If calls connect but stay
# silent, set RUSCORD_LIVEKIT_NODE_IP to this server's public IP and
# RUSCORD_LIVEKIT_EXTERNAL_IP=false.
RUSCORD_LIVEKIT_MODE=local
RUSCORD_LIVEKIT_URL=
RUSCORD_LIVEKIT_PUBLIC_URL=
RUSCORD_LIVEKIT_NODE_IP=
RUSCORD_LIVEKIT_EXTERNAL_IP=true

RUSCORD_JWT_ED25519_SEED=

RUSCORD_PG_PASSWORD=
RUSCORD_REDIS_PASSWORD=

RUSCORD_S3_BUCKET=ruscord
RUSCORD_S3_ACCESS_KEY=
RUSCORD_S3_SECRET_KEY=

RUSCORD_LIVEKIT_API_KEY=
RUSCORD_LIVEKIT_API_SECRET=
