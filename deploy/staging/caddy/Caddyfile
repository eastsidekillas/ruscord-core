# HTTPS in front of the client's nginx (deploy/staging/compose.yml). Caddy
# gets and renews the Let's Encrypt certificate for the domain itself; for
# "localhost" (CI) it uses its own local certificate authority.
{$RUSCORD_DOMAIN} {
	encode zstd gzip
	header Strict-Transport-Security "max-age=31536000"
	# What LiveKit needs from outside: nothing for the local one, the
	# webhook for LiveKit Cloud (docs/adr/0034-livekit-cloud.md).
	import /etc/caddy/livekit-{$RUSCORD_LIVEKIT_MODE}.caddy
	handle {
		reverse_proxy web:80
	}
}
