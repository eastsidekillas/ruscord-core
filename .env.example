# Copy to .env and fill in. .env is git-ignored.
RUSCORD_ENV=dev
RUSCORD_ROLES=all
RUSCORD_HTTP_ADDR=127.0.0.1:8080
RUSCORD_LOG_LEVEL=debug
RUSCORD_ALLOWED_ORIGINS=http://localhost:4200
# Size of the Postgres pool of one process (ADR-0040); auth lookups add 4.
RUSCORD_PG_MAX_CONNS=20
# GET /metrics on its own address, never behind the public proxy; "off" disables.
RUSCORD_METRICS_ADDR=127.0.0.1:9090
# Reverse proxies in front of the core (addresses or CIDRs, comma-separated).
# Their X-Forwarded-For gives the client address for per-IP limits; empty: none.
RUSCORD_TRUSTED_PROXIES=
# Ed25519 seed for access tokens. Generate: openssl rand -hex 32
RUSCORD_JWT_ED25519_SEED=

# Generate: openssl rand -hex 24
RUSCORD_PG_PASSWORD=
RUSCORD_REDIS_PASSWORD=
RUSCORD_POSTGRES_URL=postgres://ruscord:<RUSCORD_PG_PASSWORD>@127.0.0.1:5432/ruscord?sslmode=disable
RUSCORD_REDIS_ADDR=127.0.0.1:6379
RUSCORD_NATS_URL=nats://127.0.0.1:4222

# S3 storage for avatars and icons (SeaweedFS in compose). Without keys in dev
# uploads are off. Generate: openssl rand -hex 12 / openssl rand -hex 24
RUSCORD_S3_ENDPOINT=http://127.0.0.1:8333
RUSCORD_S3_BUCKET=ruscord
RUSCORD_S3_ACCESS_KEY=
RUSCORD_S3_SECRET_KEY=
# Signs links to attachments (openssl rand -hex 32); the same on every API process.
RUSCORD_CDN_SECRET=

# Generate key: openssl rand -hex 6   secret: openssl rand -base64 36
RUSCORD_LIVEKIT_URL=ws://127.0.0.1:7880
RUSCORD_LIVEKIT_API_KEY=
RUSCORD_LIVEKIT_API_SECRET=

# LiveKit: "local" — the one in this compose; "cloud" — LiveKit Cloud
# (docs/adr/0034-livekit-cloud.md). For cloud set the project's URL here and
# put its API key and secret into RUSCORD_LIVEKIT_API_KEY/SECRET.
RUSCORD_LIVEKIT_MODE=local
RUSCORD_LIVEKIT_CLOUD_URL=
